{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        // By default, all permissions are set to "ask".
        "*": "ask",

        // -------------------------------------------------------------------------
        // Allowed permissions.

        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "read": "allow",
        "todowrite": "allow",

        // -------------------------------------------------------------------------
        // Allowed external directories.

        "external_directory": {
            "/Users/ollama/log/ollama.err.log": "allow",
        },

        // -------------------------------------------------------------------------
        // Granular controls.

        "edit": {
            "app/**": "allow",
            "glasses/**": "allow",
        },
        "bash": {
            "*": "ask",
            // ADB commands.
            "adb devices": "allow",
            "adb shell pm list packages": "allow",
            "ls *": "allow",
            "cat *": "allow",
            "git log *": "allow",
            "git show *": "allow",
            "grep *": "allow",
            "head *": "allow",
            "tail *": "allow",
            // KTLint commands.
            "./gradlew ktlintFormat": "allow",
            "./gradlew :build-logic:convention:ktlintFormat ktlintFormat": "allow",
            // Build commands.
            "./gradlew :app:assembleDebug *": "allow",
            "./gradlew :glasses:assembleDebug *": "allow",
        },
    }
}
